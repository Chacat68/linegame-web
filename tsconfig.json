{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "types/**/*.ts",
    "js/data/constants.js",
    "js/data/merchant.js",
    "js/systems/merchant/MerchantSystem.js",
    "js/systems/save/SaveSystem.js"
  ]
}
